{
  "name": "github-org-management",
  "version": "1.0.0",
  "private": true,
  "description": "Validation and sync scripts for the organization .github repository",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "validate": "ts-node scripts/validate-all.ts",
    "test": "node --require ts-node/register --test scripts/__tests__/*.test.ts"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  }
}
